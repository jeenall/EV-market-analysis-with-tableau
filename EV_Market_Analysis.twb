    <worksheet name='Manudacturer Market Share'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Top 10 Manufacturers - Share of Recorded sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ev_market_train' name='federated.0sygaza1dbxoiw1emcodq0oafdh6' />
          </datasources>
          <datasource-dependencies datasource='federated.0sygaza1dbxoiw1emcodq0oafdh6'>
            <column caption='Market share %' datatype='real' default-format='p0.0%' name='[Calculation_1307655215722497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([annual_sales_units])/ TOTAL(SUM([annual_sales_units]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Annual Sales Units' datatype='real' name='[annual_sales_units]' role='measure' type='quantitative' />
            <column caption='Manufacturer' datatype='string' name='[manufacturer]' role='dimension' type='nominal' />
            <column-instance column='[manufacturer]' derivation='None' name='[none:manufacturer:nk]' pivot='key' type='nominal' />
            <column-instance column='[annual_sales_units]' derivation='Sum' name='[sum:annual_sales_units:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1307655215722497]' derivation='User' name='[usr:Calculation_1307655215722497:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0sygaza1dbxoiw1emcodq0oafdh6].[none:manufacturer:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([annual_sales_units])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:manufacturer:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
